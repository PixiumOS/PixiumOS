[Desktop Entry]
Name=PixelTweak
Comment=Minimalistic GNOME performance settings center: management of ZRAM, kernel parameters (sysctl), EarlyOOM, GameMode, CPU frequencies via sysfs and cache cleaning
Exec=bash -c "source ~/.venvs/pixeltweak/bin/activate && python3 ~/pixeltweak/pixeltweak.py"
Icon=/usr/share/ksnip_20261111-110114-removebg-preview.png
Terminal=false
Type=Application
Categories=Settings;System;Utility;
Keywords=tweak;zram;cpu;kernel;performance;gamemode;earlyoom;
StartupNotify=true
StartupWMClass=io.github.PixelTweak
